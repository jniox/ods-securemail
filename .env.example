# SecureMail Service Environment Variables

# Database
DATABASE_URL=postgres://ods:ods-dev-2026@127.0.0.1:5433/ods

# Server
HOST=0.0.0.0
PORT=8086

# Redpanda/Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=ods.securemail.events

# JWT (RS256 production mode)
# JWT_RSA_PUBLIC_KEY_B64=<base64-encoded RSA public key PEM>
# JWT_ISSUER=https://oid.staging.orbusdigital.com
# JWT_AUDIENCE=ods-platform

# JWT (HS256 dev mode — NOT for production)
JWT_ALLOW_HS256=false
# TODO: Generate with openssl rand -base64 32
JWT_SECRET=

# Master encryption key for passwords/private keys at rest (AES-256, 32 bytes hex)
# TODO: Generate 32-byte key with openssl rand -hex 32 — REQUIRED, service will fail to start without this
MASTER_ENCRYPTION_KEY=

# CORS
CORS_ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info
